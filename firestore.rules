rules_version = '2';

// 설계 설명: docs/SECURITY.md · 테스트: tests/firestore.rules.test.mjs (npm run test:rules)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function projectPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId);
    }

    function isMember(projectId) {
      return signedIn() && request.auth.uid in get(projectPath(projectId)).data.memberIds;
    }

    function isDateOrNull(v) {
      return v == null || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    // 할 일 삭제 권한: 할 일을 만든 사람 · 담당자 · 프로젝트를 만든 사람
    function canDeleteTask(projectId, task) {
      return isMember(projectId)
        && (task.createdBy == request.auth.uid
          || task.assigneeId == request.auth.uid
          || get(projectPath(projectId)).data.ownerId == request.auth.uid);
    }

    // 할 일 문서 형식 (만들기 · 수정 공통)
    function validTask(projectId, t) {
      return t.keys().hasOnly(['number', 'title', 'description', 'status', 'statusSource', 'assigneeId',
                               'startDate', 'dueDate', 'createdBy', 'createdAt', 'updatedAt'])
        && t.title is string && t.title.size() >= 1 && t.title.size() <= 100
        && t.description is string && t.description.size() <= 2000
        && t.status in ['todo', 'doing', 'done']
        && t.statusSource in ['manual', 'github']
        && (t.assigneeId == null || t.assigneeId in get(projectPath(projectId)).data.memberIds)
        && isDateOrNull(t.startDate)
        && isDateOrNull(t.dueDate)
        && (t.startDate == null || t.dueDate == null || t.startDate <= t.dueDate)
        && t.updatedAt == request.time;
    }

    // 회원 기본 정보: 로그인한 사람은 읽기(팀원 이름 표시용), 쓰기는 본인만
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;

      // GitHub 토큰: 본인만 읽고 쓰기
      match /private/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // 초대 코드 → 프로젝트 ID. 코드를 아는 사람만 단건 조회(get) 가능, 목록 조회 불가.
    // 이미 있는 코드로 만들면 "수정"이 되어 거부된다 → 코드 중복이 규칙 수준에서 막힌다.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['projectId', 'createdAt'])
        && getAfter(projectPath(request.resource.data.projectId)).data.ownerId == request.auth.uid
        && getAfter(projectPath(request.resource.data.projectId)).data.inviteCode == code;
      // 삭제: 그 프로젝트를 만든 사람만 (프로젝트 삭제 배치에서 함께 지움)
      allow delete: if signedIn()
        && get(projectPath(resource.data.projectId)).data.ownerId == request.auth.uid;
    }

    match /projects/{projectId} {
      // 멤버만 읽기
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      // 만들기: 본인이 만든 사람이자 유일한 멤버, 초대 코드 문서와 같은 배치로만
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'inviteCode', 'ownerId', 'memberIds', 'taskCounter', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.taskCounter == 0
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.projectId == projectId;

      // 참여: 멤버가 아닌 사람이 "자기 자신만" 추가, 다른 필드는 못 바꿈,
      // 같은 배치에서 쓴 joins/{uid}.code 가 프로젝트의 현재 초대 코드와 같아야 함
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
        && request.resource.data.memberIds.size() <= 10
        && getAfter(/databases/$(database)/documents/projects/$(projectId)/joins/$(request.auth.uid)).data.code == resource.data.inviteCode;

      // 나가기: 만든 사람이 아닌 멤버가 "자기 자신만" 빠짐, 다른 필드는 못 바꿈
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.auth.uid != resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid]);

      // 카드 번호 발급: 멤버가 taskCounter 를 정확히 1 올림 (할 일 만들기 트랜잭션)
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taskCounter'])
        && request.resource.data.taskCounter == resource.data.taskCounter + 1;

      // 삭제: 만든 사람만
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      // 할 일: 멤버만. 카드 번호는 같은 트랜잭션에서 올린 taskCounter 와 같아야 함(중복 · 건너뛰기 방지)
      match /tasks/{taskId} {
        allow read: if isMember(projectId);
        allow create: if isMember(projectId)
          && validTask(projectId, request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.number == getAfter(projectPath(projectId)).data.taskCounter
          && getAfter(projectPath(projectId)).data.taskCounter == get(projectPath(projectId)).data.taskCounter + 1;
        // 수정: 번호 · 만든 사람 · 만든 시각은 못 바꿈
        allow update: if isMember(projectId)
          && validTask(projectId, request.resource.data)
          && request.resource.data.number == resource.data.number
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if canDeleteTask(projectId, resource.data);

        // 상태 변경 기록: 멤버만 읽기, 본인 이름으로만 추가, 수정 · 삭제 불가 (GitHub 반영은 서버가 Admin SDK로 기록)
        match /history/{historyId} {
          allow read: if isMember(projectId);
          allow create: if isMember(projectId)
            && request.resource.data.keys().hasOnly(['from', 'to', 'source', 'actor', 'at'])
            && request.resource.data.source == 'manual'
            && request.resource.data.actor == request.auth.uid
            && request.resource.data.at == request.time;
          // 할 일을 지울 때 기록도 함께 지움 (할 일 삭제 권한이 있는 사람만)
          allow delete: if canDeleteTask(projectId, get(/databases/$(database)/documents/projects/$(projectId)/tasks/$(taskId)).data);
        }
      }

      // 참여 증명: 쓰기는 본인 문서만, 코드가 맞을 때만.
      // 읽기는 만든 사람만(삭제 때 정리용), 삭제는 본인(나가기) 또는 만든 사람(프로젝트 삭제).
      match /joins/{uid} {
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['code', 'at'])
          && request.resource.data.code == get(projectPath(projectId)).data.inviteCode;
        allow read: if signedIn() && get(projectPath(projectId)).data.ownerId == request.auth.uid;
        allow delete: if signedIn()
          && (request.auth.uid == uid || get(projectPath(projectId)).data.ownerId == request.auth.uid);
      }
    }
  }
}
