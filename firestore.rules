rules_version = '2';

// 설계 설명: docs/SECURITY.md · 테스트: tests/firestore.rules.test.mjs (npm run test:rules)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function projectPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId);
    }

    function isMember(projectId) {
      return signedIn() && request.auth.uid in get(projectPath(projectId)).data.memberIds;
    }

    function isDateOrNull(v) {
      return v == null || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function toDate(iso) {
      return timestamp.date(int(iso[0:4]), int(iso[5:7]), int(iso[8:10]));
    }

    // 일정 투표 형식: 기간 최대 14일, 하루 중 시간 0~24시, 회의 길이 1 · 2시간
    function validPoll(p) {
      return p.keys().hasOnly(['title', 'startDate', 'endDate', 'startHour', 'endHour', 'durationHours',
                               'status', 'confirmedSlot', 'createdBy', 'createdAt'])
        && p.title is string && p.title.size() >= 1 && p.title.size() <= 60
        && isDateOrNull(p.startDate) && p.startDate != null
        && isDateOrNull(p.endDate) && p.endDate != null
        && p.startDate <= p.endDate
        && toDate(p.endDate) - toDate(p.startDate) <= duration.value(13, 'd')
        && p.startHour is int && p.endHour is int
        && p.startHour >= 0 && p.endHour <= 24 && p.startHour < p.endHour
        && p.durationHours in [1, 2]
        && p.status in ['open', 'confirmed'];
    }

    // 회의록에서 등록한 다음 회의: 없음(null) 또는 날짜 · 시작 시각(0~23) · 근거 문장
    function validNextMeeting(m) {
      return m == null
        || (m is map
          && m.keys().hasOnly(['date', 'hour', 'text'])
          && isDateOrNull(m.date) && m.date != null
          && m.hour is int && m.hour >= 0 && m.hour <= 23
          && m.text is string && m.text.size() <= 200);
    }

    function validMilestone(m) {
      return m is map
        && m.keys().hasOnly(['id', 'name', 'date'])
        && m.id is string && m.id.size() >= 1 && m.id.size() <= 20
        && m.name is string && m.name.size() >= 1 && m.name.size() <= 20
        && isDateOrNull(m.date) && m.date != null;
    }

    // 규칙에는 반복문이 없어서 최대 5개를 하나씩 검사한다
    function validMilestones(list) {
      return list is list && list.size() <= 5
        && (list.size() < 1 || validMilestone(list[0]))
        && (list.size() < 2 || validMilestone(list[1]))
        && (list.size() < 3 || validMilestone(list[2]))
        && (list.size() < 4 || validMilestone(list[3]))
        && (list.size() < 5 || validMilestone(list[4]));
    }

    // 할 일 삭제 권한: 할 일을 만든 사람 · 담당자 · 프로젝트를 만든 사람
    function canDeleteTask(projectId, task) {
      return isMember(projectId)
        && (task.createdBy == request.auth.uid
          || task.assigneeId == request.auth.uid
          || get(projectPath(projectId)).data.ownerId == request.auth.uid);
    }

    // 할 일 문서 형식 (만들기 · 수정 공통)
    function validTask(projectId, t) {
      return t.keys().hasOnly(['number', 'title', 'description', 'status', 'statusSource', 'assigneeId',
                               'startDate', 'dueDate', 'createdBy', 'createdAt', 'updatedAt', 'branch', 'github'])
        && t.title is string && t.title.size() >= 1 && t.title.size() <= 100
        && t.description is string && t.description.size() <= 2000
        && t.status in ['todo', 'doing', 'done']
        && t.statusSource in ['manual', 'github']
        && (t.assigneeId == null || t.assigneeId in get(projectPath(projectId)).data.memberIds)
        && isDateOrNull(t.startDate)
        && isDateOrNull(t.dueDate)
        && (t.startDate == null || t.dueDate == null || t.startDate <= t.dueDate)
        && t.updatedAt == request.time;
    }

    // 회원 기본 정보: 로그인한 사람은 읽기(팀원 이름 표시용), 쓰기는 본인만
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;

      // GitHub 토큰: 본인만 읽고 쓰기
      match /private/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // 레포 → 프로젝트 · 웹훅 secret: 서버(Admin SDK) 전용. 규칙이 없으므로 브라우저는 읽기 · 쓰기 모두 거부

    // 초대 코드 → 프로젝트 ID. 코드를 아는 사람만 단건 조회(get) 가능, 목록 조회 불가.
    // 이미 있는 코드로 만들면 "수정"이 되어 거부된다 → 코드 중복이 규칙 수준에서 막힌다.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['projectId', 'createdAt'])
        && getAfter(projectPath(request.resource.data.projectId)).data.ownerId == request.auth.uid
        && getAfter(projectPath(request.resource.data.projectId)).data.inviteCode == code;
      // 삭제: 그 프로젝트를 만든 사람만 (프로젝트 삭제 배치에서 함께 지움)
      allow delete: if signedIn()
        && get(projectPath(resource.data.projectId)).data.ownerId == request.auth.uid;
    }

    match /projects/{projectId} {
      // 멤버만 읽기
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      // 만들기: 본인이 만든 사람이자 유일한 멤버, 초대 코드 문서와 같은 배치로만
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'inviteCode', 'ownerId', 'memberIds', 'taskCounter', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.taskCounter == 0
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.projectId == projectId;

      // 참여: 멤버가 아닌 사람이 "자기 자신만" 추가, 다른 필드는 못 바꿈,
      // 같은 배치에서 쓴 joins/{uid}.code 가 프로젝트의 현재 초대 코드와 같아야 함
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
        && request.resource.data.memberIds.size() <= 10
        && getAfter(/databases/$(database)/documents/projects/$(projectId)/joins/$(request.auth.uid)).data.code == resource.data.inviteCode;

      // 나가기: 만든 사람이 아닌 멤버가 "자기 자신만" 빠짐, 다른 필드는 못 바꿈
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.auth.uid != resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid]);

      // 카드 번호 발급: 멤버가 taskCounter 를 정확히 1 올림 (할 일 만들기 트랜잭션)
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taskCounter'])
        && request.resource.data.taskCounter == resource.data.taskCounter + 1;

      // 이름 바꾸기: 만든 사람만, 이름만
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40;

      // 초대 코드 재발급: 만든 사람만. 같은 배치에서 새 코드 문서가 이 프로젝트를 가리켜야 함
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteCode'])
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.matches('^[A-HJ-NP-Z2-9]{6}$')
        && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.projectId == projectId;

      // 마일스톤 목록: 만든 사람만, 최대 5개, 각 항목은 id · 이름(1~20자) · 날짜. 예전 형식(milestone)은 지우기만 허용
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['milestones', 'milestone'])
        && request.resource.data.get('milestone', null) == null
        && validMilestones(request.resource.data.get('milestones', []));

      // 멤버 내보내기: 만든 사람만, 한 번에 한 명 빼기만 (추가 · 자기 자신 빼기 불가)
      allow update: if signedIn()
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && resource.data.memberIds.hasAll(request.resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && resource.data.ownerId in request.resource.data.memberIds;

      // 삭제: 만든 사람만
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      // 할 일: 멤버만. 카드 번호는 같은 트랜잭션에서 올린 taskCounter 와 같아야 함(중복 · 건너뛰기 방지)
      match /tasks/{taskId} {
        allow read: if isMember(projectId);
        allow create: if isMember(projectId)
          && validTask(projectId, request.resource.data)
          && !('branch' in request.resource.data) && !('github' in request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.number == getAfter(projectPath(projectId)).data.taskCounter
          && getAfter(projectPath(projectId)).data.taskCounter == get(projectPath(projectId)).data.taskCounter + 1;
        // 수정: 번호 · 만든 사람 · 만든 시각은 못 바꿈. 브랜치 · PR 정보(branch · github)는 GitHub 웹훅 서버만 쓴다
        allow update: if isMember(projectId)
          && validTask(projectId, request.resource.data)
          && request.resource.data.get('branch', null) == resource.data.get('branch', null)
          && request.resource.data.get('github', null) == resource.data.get('github', null)
          && request.resource.data.number == resource.data.number
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if canDeleteTask(projectId, resource.data);

        // 상태 변경 기록: 멤버만 읽기, 본인 이름으로만 추가, 수정 · 삭제 불가 (GitHub 반영은 서버가 Admin SDK로 기록)
        match /history/{historyId} {
          allow read: if isMember(projectId);
          allow create: if isMember(projectId)
            && request.resource.data.keys().hasOnly(['from', 'to', 'source', 'actor', 'at'])
            && request.resource.data.source == 'manual'
            && request.resource.data.actor == request.auth.uid
            && request.resource.data.at == request.time;
          // 할 일을 지울 때 기록도 함께 지움 (할 일 삭제 권한이 있는 사람만)
          allow delete: if canDeleteTask(projectId, get(/databases/$(database)/documents/projects/$(projectId)/tasks/$(taskId)).data);
        }
      }

      // 참여 증명: 쓰기는 본인 문서만, 코드가 맞을 때만.
      // 읽기는 만든 사람만(삭제 때 정리용), 삭제는 본인(나가기) 또는 만든 사람(프로젝트 삭제).
      match /joins/{uid} {
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['code', 'at'])
          && request.resource.data.code == get(projectPath(projectId)).data.inviteCode;
        allow read: if signedIn() && get(projectPath(projectId)).data.ownerId == request.auth.uid;
        allow delete: if signedIn()
          && (request.auth.uid == uid || get(projectPath(projectId)).data.ownerId == request.auth.uid);
      }

      // GitHub 활동 기록: 멤버만 읽기, 쓰기는 웹훅 서버(Admin SDK)만. 삭제는 프로젝트를 지울 때 만든 사람만
      match /githubEvents/{eventId} {
        allow read: if isMember(projectId);
        allow delete: if signedIn() && get(projectPath(projectId)).data.ownerId == request.auth.uid;
      }

      // 회의록: 만들기는 서버(/api/meetings, Admin SDK)만 — 음성 인식 · 후보 추출 결과를 브라우저가 위조하지 못하게.
      // 멤버는 읽기 + 할 일 후보의 "보드에 추가됨(taskNumber)" 표시 · 다음 회의 등록만 수정. 삭제는 만든 사람 · 프로젝트를 만든 사람
      match /meetings/{meetingId} {
        allow read: if isMember(projectId);
        allow update: if isMember(projectId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actionItems', 'nextMeeting'])
          && request.resource.data.actionItems is list
          && request.resource.data.actionItems.size() == resource.data.actionItems.size()
          && validNextMeeting(request.resource.data.get('nextMeeting', null));
        allow delete: if isMember(projectId)
          && (resource.data.createdBy == request.auth.uid || get(projectPath(projectId)).data.ownerId == request.auth.uid);
      }

      // 일정 투표: 멤버만 보고 만든다. 확정 · 다시 열기 · 삭제는 투표를 만든 사람(삭제는 프로젝트 만든 사람도)
      match /polls/{pollId} {
        allow read: if isMember(projectId);
        allow create: if isMember(projectId)
          && validPoll(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.status == 'open'
          && request.resource.data.confirmedSlot == null;
        allow update: if isMember(projectId)
          && resource.data.createdBy == request.auth.uid
          && validPoll(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedSlot']);
        allow delete: if isMember(projectId)
          && (resource.data.createdBy == request.auth.uid || get(projectPath(projectId)).data.ownerId == request.auth.uid);

        // 가능 시간 응답: 사람마다 문서 1개, 본인 것만 쓰기, 투표가 열려 있을 때만
        match /responses/{uid} {
          allow read: if isMember(projectId);
          allow write: if isMember(projectId)
            && request.auth.uid == uid
            && get(/databases/$(database)/documents/projects/$(projectId)/polls/$(pollId)).data.status == 'open'
            && request.resource.data.keys().hasOnly(['slots', 'updatedAt'])
            && request.resource.data.slots is list
            && request.resource.data.slots.size() <= 336
            && request.resource.data.updatedAt == request.time;
          // 본인, 또는 투표를 지울 수 있는 사람(투표를 만든 사람 · 프로젝트를 만든 사람)이 투표와 함께 지움
          allow delete: if isMember(projectId)
            && (request.auth.uid == uid
              || get(/databases/$(database)/documents/projects/$(projectId)/polls/$(pollId)).data.createdBy == request.auth.uid
              || get(projectPath(projectId)).data.ownerId == request.auth.uid);
        }
      }
    }
  }
}
